@url = http://localhost:8080/api/auth

### Authenticate

POST {{url}}/authenticate HTTP/1.1
Content-Type: application/json

{
    "email": "test@example.com",
    "password": "password1."
}

### Register

POST {{url}}/register HTTP/1.1
Content-Type: application/json

{
    "firstName": "test",
    "lastName": "example",
    "email": "test@example.com",
    "username": "testExample",
    "password": "P@ssw0rd!"
}

# All first 5 users share the same password: P@ssw0rd!
# To login as any of the first 5, just change the email
### Login as Alice

POST {{url}}/authenticate HTTP/1.1
Content-Type: application/json

{
  "email": "alice.johnson@example.com",
  "password": "P@ssw0rd!"
}

